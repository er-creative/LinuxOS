#pragma once
#include "devai/strategy/dev_ai_strategy/DevinderjeetSupervisor.hpp"
#include <memory>
#include <string>
#include <vector>

namespace devai::strategy {
// A lightweight execution/reporting adapter. Existing DevManager signal selection
// remains intact: call trade() with its selected agent/action/size and current price.
// The trained shared model is owned by the application and injected into all agents;
// this adapter intentionally does not train or duplicate it.
class DevSupervisedManager {
public:
    DevSupervisedManager(std::string manager_id, DevinderjeetSupervisor& supervisor);
    DevOrderReport trade(const std::string& order_id, const std::string& agent_id,
                         const std::string& symbol, DevSupervisedAction action,
                         std::int64_t timestamp, std::int64_t shares, double price);
    const std::vector<DevOrderReport>& reports() const noexcept { return reports_; }
    const std::string& id() const noexcept { return id_; }
private:
    std::string id_;
    DevinderjeetSupervisor& supervisor_;
    std::vector<DevOrderReport> reports_;
};
}
